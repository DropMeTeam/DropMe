{
  "name": "dropme",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "admin"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\" \"npm run dev --workspace admin\"",
    "build": "npm run build --workspace client",
    "lint": "npm run lint --workspace client",
    "format": "npm run format --workspace client"
  },
  "devDependencies": {
    "artillery": "^2.0.30",
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0"
  }
}
